# Required: MongoDB URI (local MongoDB or your MongoDB Atlas connection string).
MONGODB_CONNECTIONSTRING=mongodb://127.0.0.1:27017/synesthesia

# Required: use a long, randomly generated secret for signing login tokens.
JWT_ACCESS_SECRET=

# Required for photo/video analysis and AI regional/nostalgia recommendations.
GEMINI_API_KEY=

# Optional settings; these match the backend defaults.
PORT=3000
JWT_ACCESS_EXPIRES_IN=30m
GEMINI_MODEL=gemini-3.5-flash-lite

# Required for in-app YouTube search/playback.
YOUTUBE_API_KEY=

# Optional: Last.fm charts, including the fallback when Gemini is not configured.
LASTFM_API_KEY=
